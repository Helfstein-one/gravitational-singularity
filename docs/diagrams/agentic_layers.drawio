        <mxCell id="legend" value="&lt;b&gt;LEGENDA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#3fb950'&gt;■ borda sólida verde&lt;/font&gt; = ATIVO (conectado em runtime via hook, MCP ou daemon)&lt;br&gt;&lt;br&gt;&lt;font color='#d29922'&gt;▢ borda tracejada âmbar&lt;/font&gt; = BIBLIOTECA (implementado e testado, sem adaptador que o chame ainda)&lt;br&gt;&lt;br&gt;seta sólida = fluxo real · seta tracejada = fluxo previsto&lt;br&gt;&lt;br&gt;&lt;font color='#8b949e'&gt;Python stdlib 3.10+ · arquitetura hexagonal&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#161b22;strokeColor=#8b949e;fontColor=#e6edf3;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1270" y="100" width="290" height="300" as="geometry"/></mxCell>
