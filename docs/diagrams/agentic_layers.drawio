<mxfile host="app.diagrams.net" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="agentic-layers" name="Camadas de Ação Agêntica">
    <mxGraphModel dx="1600" dy="1260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1260" background="#0d1117" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="EVENT HORIZON · CAMADAS DE AÇÃO AGÊNTICA" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#58a6ff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="28" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="c2" value="Do prompt ao disco: orquestração na nuvem, interceptação em RAM, execução local Tier 0, memória epistêmica e modelos residentes no Apple Silicon" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#8b949e;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="150" y="64" width="1300" height="22" as="geometry"/></mxCell>
        <mxCell id="L1" value="CAMADA 1 · ENTRADA &amp;amp; ORQUESTRAÇÃO (Cloud)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#161b22;strokeColor=#58a6ff;fontColor=#58a6ff;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=54;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1200" height="120" as="geometry"/></mxCell>
        <mxCell id="L2" value="CAMADA 2 · INTERCEPTAÇÃO PreToolUse (antes de executar/escrever)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#161b22;strokeColor=#f85149;fontColor=#f85149;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=54;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1200" height="160" as="geometry"/></mxCell>
        <mxCell id="L3" value="CAMADA 3 · ROTEAMENTO COGNITIVO (Sistema 1 vs Sistema 2)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#161b22;strokeColor=#a371f7;fontColor=#a371f7;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=54;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1200" height="150" as="geometry"/></mxCell>
        <mxCell id="L4" value="CAMADA 4 · EXECUÇÃO LOCAL TIER 0 (custo de nuvem $0)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#161b22;strokeColor=#3fb950;fontColor=#3fb950;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=54;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1200" height="170" as="geometry"/></mxCell>
        <mxCell id="L5" value="CAMADA 5 · MEMÓRIA &amp;amp; CONTEXTO" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#161b22;strokeColor=#39c5cf;fontColor=#39c5cf;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=54;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1200" height="160" as="geometry"/></mxCell>
        <mxCell id="L6" value="CAMADA 6 · MODELOS LOCAIS &amp;amp; HARDWARE (Apple Silicon 16 GB · Metal GPU)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#161b22;strokeColor=#f0883e;fontColor=#f0883e;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=54;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1200" height="200" as="geometry"/></mxCell>
        <mxCell id="dev" value="&lt;b&gt;&lt;font color='#58a6ff' style='font-size:14px'&gt;Desenvolvedor&lt;/font&gt;&lt;/b&gt; &lt;font color='#3fb950' style='font-size:10px'&gt;● ATIVO&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Prompt em linguagem natural&lt;br&gt;/grill-me · /plan · pedidos de edição&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#3fb950;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="130" width="230" height="76" as="geometry"/></mxCell>
        <mxCell id="ide" value="&lt;b&gt;&lt;font color='#58a6ff' style='font-size:14px'&gt;Antigravity IDE · Agente Orquestrador&lt;/font&gt;&lt;/b&gt; &lt;font color='#3fb950' style='font-size:10px'&gt;● ATIVO&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Planeja e emite tool calls: edit_file, run_command, view_file, MCP&lt;br&gt;Segue AGENTS.md (Event Horizon: patches cirúrgicos, brevidade)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#3fb950;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="130" width="500" height="76" as="geometry"/></mxCell>
        <mxCell id="cloud" value="&lt;b&gt;&lt;font color='#58a6ff' style='font-size:14px'&gt;Tiers de modelo na nuvem&lt;/font&gt;&lt;/b&gt; &lt;font color='#3fb950' style='font-size:10px'&gt;● ATIVO&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;pro: arquitetura e decisões críticas&lt;br&gt;flash: pesquisa ampla · flash_lite: lint/lookups&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#3fb950;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="330" height="76" as="geometry"/></mxCell>
        <mxCell id="hook" value="&lt;b&gt;&lt;font color='#f85149' style='font-size:14px'&gt;hook_pre_tool.py&lt;/font&gt;&lt;/b&gt; &lt;font color='#3fb950' style='font-size:10px'&gt;● ATIVO&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Recebe a tool call (JSON via stdin)&lt;br&gt;→ hook_adapter.run_hook()&lt;br&gt;Falha segura: payload inválido = allow&lt;br&gt;Executa em toda tool call&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#3fb950;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="272" width="250" height="114" as="geometry"/></mxCell>
        <mxCell id="guard" value="&lt;b&gt;&lt;font color='#f85149' style='font-size:14px'&gt;GuardrailInterceptor.evaluate()&lt;/font&gt;&lt;/b&gt; &lt;font color='#3fb950' style='font-size:10px'&gt;● ATIVO&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;1. Comando destrutivo → deny&lt;br&gt;2. view_file sem fatia em arquivo longo → deny&lt;br&gt;3. Patch aplicado em RAM + ast.parse → deny se sintaxe quebrar&lt;br&gt;4. Testes → prefixa test-slicer · comandos verbosos → prefixa rtk&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#3fb950;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="370" y="272" width="510" height="114" as="geometry"/></mxCell>
        <mxCell id="decision" value="&lt;b&gt;&lt;font color='#f85149' style='font-size:14px'&gt;Decisão devolvida ao IDE&lt;/font&gt;&lt;/b&gt; &lt;font color='#3fb950' style='font-size:10px'&gt;● ATIVO&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;allow → tool executa normalmente&lt;br&gt;deny → motivo + linha do erro&lt;br&gt;overwrite → CommandLine reescrita&lt;br&gt;(nada toca o disco antes disso)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#3fb950;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="910" y="272" width="300" height="114" as="geometry"/></mxCell>
        <mxCell id="arbiter" value="&lt;b&gt;&lt;font color='#a371f7' style='font-size:14px'&gt;CognitiveArbiter&lt;/font&gt;&lt;/b&gt; &lt;font color='#d29922' style='font-size:10px'&gt;○ BIBLIOTECA&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Classifica a tarefa por heurística (&amp;lt;2 ms)&lt;br&gt;Sistema 1: local, rápido · Sistema 2: nuvem&lt;br&gt;Calcula envelope de orçamento de tokens&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#d29922;strokeWidth=2;dashed=1;dashPattern=7 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="452" width="360" height="102" as="geometry"/></mxCell>
        <mxCell id="breaker" value="&lt;b&gt;&lt;font color='#a371f7' style='font-size:14px'&gt;EscalationCircuitBreaker&lt;/font&gt;&lt;/b&gt; &lt;font color='#d29922' style='font-size:10px'&gt;○ BIBLIOTECA&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;1ª falha local → permite 1 retry&lt;br&gt;2ª falha → abre o circuito&lt;br&gt;Gera handoff cirúrgico para a nuvem&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#d29922;strokeWidth=2;dashed=1;dashPattern=7 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="470" y="452" width="360" height="102" as="geometry"/></mxCell>
        <mxCell id="squeezer" value="&lt;b&gt;&lt;font color='#a371f7' style='font-size:14px'&gt;EpistemicContextSqueezer&lt;/font&gt;&lt;/b&gt; &lt;font color='#d29922' style='font-size:10px'&gt;○ BIBLIOTECA&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Poda virtual do histórico (teto 8k tokens)&lt;br&gt;Preserva input do usuário + 2 turnos recentes&lt;br&gt;Não-destrutivo: projeção em memória&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#d29922;strokeWidth=2;dashed=1;dashPattern=7 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="850" y="452" width="360" height="102" as="geometry"/></mxCell>
        <mxCell id="mcp" value="&lt;b&gt;&lt;font color='#3fb950' style='font-size:14px'&gt;local-llm-mcp (mcp_adapter.py)&lt;/font&gt;&lt;/b&gt; &lt;font color='#3fb950' style='font-size:10px'&gt;● ATIVO&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Chamado pelo IDE via MCP stdio (JSON-RPC)&lt;br&gt;query_local_llm · local_extract_json&lt;br&gt;local_format_code · local_semantic_search&lt;br&gt;local_draft_patch&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#3fb950;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="622" width="360" height="122" as="geometry"/></mxCell>
        <mxCell id="drafter" value="&lt;b&gt;&lt;font color='#3fb950' style='font-size:14px'&gt;SpeculativeDrafter&lt;/font&gt;&lt;/b&gt; &lt;font color='#3fb950' style='font-size:10px'&gt;● ATIVO&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;+ SemanticRetriever&lt;br&gt;Draft no qwen 7B + validação AST&lt;br&gt;1 retry de auto-correção&lt;br&gt;RAG: chunks AST + nomic-embed&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#3fb950;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="470" y="622" width="260" height="122" as="geometry"/></mxCell>
        <mxCell id="cascade" value="&lt;b&gt;&lt;font color='#3fb950' style='font-size:14px'&gt;HierarchicalCascade&lt;/font&gt;&lt;/b&gt; &lt;font color='#d29922' style='font-size:10px'&gt;○ BIBLIOTECA&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Micro-tarefa → smollm2 1.7B&lt;br&gt;AST inválida → promove p/ 7B&lt;br&gt;Estrutural → direto no 7B&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#d29922;strokeWidth=2;dashed=1;dashPattern=7 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="750" y="622" width="225" height="122" as="geometry"/></mxCell>
        <mxCell id="reflector" value="&lt;b&gt;&lt;font color='#3fb950' style='font-size:14px'&gt;AdversarialReflector&lt;/font&gt;&lt;/b&gt; &lt;font color='#d29922' style='font-size:10px'&gt;○ BIBLIOTECA&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Builder (qwen 7B) gera&lt;br&gt;Skeptic (r1 1.5B) critica&lt;br&gt;No máx. 1 rodada de refino&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#d29922;strokeWidth=2;dashed=1;dashPattern=7 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="990" y="622" width="220" height="122" as="geometry"/></mxCell>
        <mxCell id="prewarmer" value="&lt;b&gt;&lt;font color='#39c5cf' style='font-size:14px'&gt;PredictivePreWarmer&lt;/font&gt;&lt;/b&gt; &lt;font color='#3fb950' style='font-size:10px'&gt;● ATIVO&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Thread dentro do daemon :7890&lt;br&gt;Varre src/ e tests/ (mtime + size)&lt;br&gt;Debounce 300 ms → pré-esqueletiza&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#3fb950;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="812" width="260" height="112" as="geometry"/></mxCell>
        <mxCell id="memoizer" value="&lt;b&gt;&lt;font color='#39c5cf' style='font-size:14px'&gt;EpistemicMemoizer&lt;/font&gt;&lt;/b&gt; &lt;font color='#3fb950' style='font-size:10px'&gt;● ATIVO&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;+ CodeSkeletonizer&lt;br&gt;Chave: sha256(conteúdo) + prompt + tool&lt;br&gt;Esqueleto AST ≈ 68% menos tokens&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#3fb950;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="370" y="812" width="270" height="112" as="geometry"/></mxCell>
        <mxCell id="sqlite" value="&lt;b&gt;&lt;font color='#39c5cf' style='font-size:14px'&gt;Cache Epistêmico L1 / L2&lt;/font&gt;&lt;/b&gt; &lt;font color='#3fb950' style='font-size:10px'&gt;● ATIVO&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;L1: LRU em RAM (500 entradas)&lt;br&gt;L2: SQLite WAL em disco&lt;br&gt;~/.gemini/config/cache/epistemic.db&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#3fb950;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="670" y="812" width="250" height="112" as="geometry"/></mxCell>
        <mxCell id="merkle" value="&lt;b&gt;&lt;font color='#39c5cf' style='font-size:14px'&gt;AstMerkleEngine&lt;/font&gt;&lt;/b&gt; &lt;font color='#d29922' style='font-size:10px'&gt;○ BIBLIOTECA&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Um nó por símbolo, hash SHA-256&lt;br&gt;Re-esqueletiza só o nó alterado&lt;br&gt;Persiste em ast_merkle_nodes (L2)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#d29922;strokeWidth=2;dashed=1;dashPattern=7 5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="940" y="812" width="270" height="112" as="geometry"/></mxCell>
        <mxCell id="optimizer" value="&lt;b&gt;&lt;font color='#f0883e' style='font-size:14px'&gt;InferenceOptimizer&lt;/font&gt;&lt;/b&gt; &lt;font color='#3fb950' style='font-size:10px'&gt;● ATIVO&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Boot do daemon: warmup_async()&lt;br&gt;keep_alive = -1 nos 3 modelos núcleo&lt;br&gt;OllamaAdapter injeta num_keep&lt;br&gt;(≈ tokens do system prompt)&lt;br&gt;Orçamento VRAM alvo: ≤ 7 GB&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#3fb950;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="992" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="ollama" value="&lt;b&gt;&lt;font color='#f0883e' style='font-size:14px'&gt;Ollama :11434&lt;/font&gt;&lt;/b&gt; &lt;font color='#3fb950' style='font-size:10px'&gt;● ATIVO&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;/api/generate&lt;br&gt;/api/embeddings&lt;br&gt;/api/ps (inspeção de VRAM)&lt;br&gt;Metal GPU · memória unificada&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#3fb950;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="992" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="m_smol" value="&lt;b&gt;&lt;font color='#f0883e' style='font-size:14px'&gt;smollm2:1.7b&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Micro-worker · ~1.0 GB&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#f0883e;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="700" y="992" width="160" height="66" as="geometry"/></mxCell>
        <mxCell id="m_r1" value="&lt;b&gt;&lt;font color='#f0883e' style='font-size:14px'&gt;deepseek-r1:1.5b&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Skeptic · ~1.1 GB&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#f0883e;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="875" y="992" width="160" height="66" as="geometry"/></mxCell>
        <mxCell id="m_qwen" value="&lt;b&gt;&lt;font color='#f0883e' style='font-size:14px'&gt;qwen2.5-coder:7b&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Builder · ~4.7 GB&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#f0883e;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1050" y="992" width="160" height="66" as="geometry"/></mxCell>
        <mxCell id="m_embed" value="&lt;b&gt;&lt;font color='#f0883e' style='font-size:14px'&gt;nomic-embed-text&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Scout / RAG · ~0.27 GB&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#f0883e;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="700" y="1074" width="245" height="66" as="geometry"/></mxCell>
        <mxCell id="m_hermes" value="&lt;b&gt;&lt;font color='#f0883e' style='font-size:14px'&gt;hermes3:3b&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;Distiller de sessão · ~2.0 GB&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#f0883e;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="965" y="1074" width="245" height="66" as="geometry"/></mxCell>
        <mxCell id="telemetry" value="&lt;b&gt;&lt;font color='#58a6ff' style='font-size:14px'&gt;Daemon de Telemetria :7890&lt;/font&gt;&lt;/b&gt; &lt;font color='#3fb950' style='font-size:10px'&gt;● ATIVO&lt;/font&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;http_telemetry_adapter (start/stop/restart)&lt;br&gt;No boot inicia: PreWarmer + warmup VRAM&lt;br&gt;GET /api/stats · dashboard web&lt;br&gt;&amp;nbsp;&lt;br&gt;Métricas calculadas de dados reais:&lt;br&gt;· tokens, custo, economia (transcripts)&lt;br&gt;· epistemic_cache (contagem no SQLite)&lt;br&gt;· predictive_prewarm (thread ativa)&lt;br&gt;&amp;nbsp;&lt;br&gt;Valores fixos / ilustrativos hoje:&lt;br&gt;· cascade_metrics&lt;br&gt;· merkle_tree_metrics&lt;br&gt;· vram_coresidence_metrics&lt;br&gt;· adversarial_reflection_metrics&lt;br&gt;· context_squeeze_metrics&lt;br&gt;&amp;nbsp;&lt;br&gt;Tornam-se reais quando os módulos&lt;br&gt;da camada 3/4/5 forem conectados.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#3fb950;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1270" y="420" width="290" height="360" as="geometry"/></mxCell>
        <mxCell id="flow" value="&lt;b&gt;&lt;font color='#58a6ff' style='font-size:14px'&gt;Fluxo típico de uma edição&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#e6edf3' style='font-size:12px'&gt;① Dev descreve a mudança&lt;br&gt;② IDE planeja e (opcional) consulta&lt;br&gt;     o MCP local para RAG / draft&lt;br&gt;③ Draft local: qwen 7B + AST check&lt;br&gt;④ IDE emite edit_file / run_command&lt;br&gt;⑤ Hook valida em RAM: allow/deny&lt;br&gt;⑥ Só então o disco é alterado&lt;br&gt;⑦ PreWarmer vê o mtime novo e&lt;br&gt;     re-esqueletiza para o cache&lt;br&gt;⑧ Próxima leitura sai do cache L1&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1c2128;strokeColor=#58a6ff;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1270" y="800" width="290" height="240" as="geometry"/></mxCell>
